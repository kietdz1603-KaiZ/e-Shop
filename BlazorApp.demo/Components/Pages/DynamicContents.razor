@page "/Dynamic"
@rendermode InteractiveServer

<h3>Our First Dynamic Contents</h3>

<br />
<br />
<button @onclick="HandleBlazerServerClick">Blazer Server</button>
<button @onclick="HandleBlazerWebAssemblyClick">Blazer WebAssembly</button>
<br />
<br />
<h3>@title</h3>
<br />
<div>
	@content
</div>

@code {
	private string title = "";
	private string content = "";

			private void HandleBlazerServerClick()
			{
				title = "Blazer Server";
				content = "Blazer Server sẽ khởi tạo nhứng nội dung động (dynamic content)"
				+ " ở máy chủ và gửi nội dung tơi trình duyệt thông qua giao thức SignaLR ";
			}
			private void HandleBlazerWebAssemblyClick()
			{
				title = "Blazer WebAssembly";
				content = "Blazer WebAssembly chạy hoàn toàn ở trình duyệt và " +
				" khởi tạo những nội dung động ngay tại trình duyệt";
			}
}
