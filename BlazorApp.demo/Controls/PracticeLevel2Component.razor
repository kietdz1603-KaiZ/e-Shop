<div class="card bg-white border-info p-3 m-2">
    <h4>Tầng 2 (Child Level 2 Component)</h4>
    <p>
        <strong>Nhận từ cha (Level 1 qua Parameter):</strong> 
        <span class="badge bg-secondary">@MessageFromParent</span>
    </p>

    <!-- Truyền tiếp dữ liệu xuống Tầng 3 và nhận EventCallback ngược lại -->
    <PracticeLevel3Component 
        SelectedProductId="SelectedProductId" 
        MessageFromParent="@(MessageFromParent + " ➔ Đã qua Tầng 2")"
        OnSelectProduct="HandleSelectProduct">
    </PracticeLevel3Component>
</div>

@code {
    [Parameter]
    public int SelectedProductId { get; set; }

    [Parameter]
    public string MessageFromParent { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<int> OnSelectProduct { get; set; }

    private async Task HandleSelectProduct(int id)
    {
        // Chuyển tiếp EventCallback từ Tầng 3 lên Tầng 1
        if (OnSelectProduct.HasDelegate)
        {
            await OnSelectProduct.InvokeAsync(id);
        }
    }
}
