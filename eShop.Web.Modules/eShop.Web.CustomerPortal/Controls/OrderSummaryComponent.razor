@inject NavigationManager navigationManager

<div class="order-summary-box">
    <h5 class="summary-title">
        <i class="bi bi-receipt-cutoff text-primary me-2"></i>Tóm Tắt Đơn Hàng
    </h5>

    <div class="summary-row">
        <span>Tạm tính (@itemsCount sản phẩm):</span>
        <span class="fw-semibold text-dark">@itemsTotalPrice.ToString("c")</span>
    </div>

    <div class="summary-row">
        <span>Phí vận chuyển:</span>
        <span class="text-success fw-bold">Miễn Phí</span>
    </div>

    <div class="summary-row">
        <span>Thuế VAT:</span>
        <span class="text-muted">$0.00</span>
    </div>

    <!-- Voucher / Promo Code Box -->
    <div class="my-3 p-2 bg-light rounded-3">
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-ticket-perforated text-primary"></i></span>
            <input type="text" class="form-control border-start-0" placeholder="Mã giảm giá (VD: ESHOP2026)" />
            <button class="btn btn-outline-primary fw-bold" type="button">Áp dụng</button>
        </div>
    </div>

    <div class="summary-total-row">
        <span>Tổng thanh toán:</span>
        <span class="summary-total-price">@itemsTotalPrice.ToString("c")</span>
    </div>
    <div class="text-muted small text-end mt-1">(Đã bao gồm VAT & phí giao hàng)</div>

    @if (!HidePlaceOrder)
    {
        <button class="btn-checkout" @onclick="PlaceOrder">
            <i class="bi bi-bag-check-fill"></i>
            <span>Tiến Hành Đặt Hàng</span>
        </button>

        <div class="mt-3 pt-3 border-top text-center">
            <div class="d-flex justify-content-center gap-3 text-muted small">
                <span><i class="bi bi-shield-check text-success"></i> Bảo mật 100%</span>
                <span><i class="bi bi-truck text-primary"></i> Giao siêu tốc</span>
            </div>
        </div>
    }
</div>

@code {
    int itemsCount = 0;
    double itemsTotalPrice = 0;

    [Parameter]
    public Order order { get; set; }

    [Parameter]
    public bool HidePlaceOrder { get; set; } = false;

    protected override void OnParametersSet() {
        base.OnParametersSet();
        if (order != null) {
            itemsCount = order.LineItems.Count;
            itemsTotalPrice = 0;
            order.LineItems.ForEach(x => itemsTotalPrice += x.Price * x.Quantity);
        }
    }

    private void PlaceOrder() {
        navigationManager.NavigateTo("/placeorder");
    }
}
