@page "/orderconfirm/{uniqueId}"

@inject IViewOrderConfirmationUseCase viewOrderConfirmationUseCase

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Trang Chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Xác Nhận Đơn Hàng</li>
    </ol>
</nav>

<!-- Step Indicator -->
<div class="checkout-step-indicator">
    <div class="step-item text-success">
        <div class="step-num bg-success text-white"><i class="bi bi-check-lg"></i></div>
        <span>Giỏ Hàng</span>
    </div>
    <div class="step-line border-top flex-grow-1" style="max-width: 80px;"></div>
    <div class="step-item text-success">
        <div class="step-num bg-success text-white"><i class="bi bi-check-lg"></i></div>
        <span>Thanh Toán</span>
    </div>
    <div class="step-line border-top flex-grow-1" style="max-width: 80px;"></div>
    <div class="step-item active">
        <div class="step-num bg-success text-white"><i class="bi bi-check-lg"></i></div>
        <span class="text-success fw-bold">Hoàn Tất</span>
    </div>
</div>

@if (order != null)
{
    <!-- Success Celebration Card -->
    <div class="order-success-card">
        <div class="success-icon-badge">
            <i class="bi bi-check-lg"></i>
        </div>
        <h2 class="fw-bold mb-2">Đặt Hàng Thành Công!</h2>
        <p class="text-muted mb-3">
            Cảm ơn bạn đã lựa chọn <b>eShop Beauty</b>. Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.
        </p>

        <div class="order-code-badge">
            <i class="bi bi-hash"></i> Mã Đơn Hàng: <b>@UniqueId</b>
        </div>

        <p class="text-secondary small mb-4">
            <i class="bi bi-clock-history me-1"></i> Dự kiến giao hàng: <b>2 - 3 ngày làm việc</b> (Nhân viên giao hàng sẽ gọi trước khi đến).
        </p>

        <div class="d-flex justify-content-center gap-3">
            <a href="/products" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                <i class="bi bi-arrow-left me-2"></i> Tiếp Tục Mua Sắm
            </a>
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2" onclick="window.print()">
                <i class="bi bi-printer me-2"></i> In Hóa Đơn
            </button>
        </div>
    </div>

    <!-- Order Details Row -->
    <div class="row g-4 mb-5">
        <!-- Customer Info Card -->
        <div class="col-lg-6">
            <div class="card rounded-4 border-light shadow-sm p-4 bg-white h-100">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i>Thông Tin Giao Nhận
                </h5>
                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Người nhận:</span>
                        <span class="fw-bold text-dark">@order.CustomerName</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Địa chỉ:</span>
                        <span class="fw-semibold text-dark text-end">@order.CustomerAddress</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Khu vực:</span>
                        <span class="fw-semibold text-dark">@order.CustomerCity, @order.CustomerStateProvince</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Quốc gia:</span>
                        <span class="fw-semibold text-dark">@order.CustomerCountry</span>
                    </div>
                    <div class="d-flex justify-content-between pt-1">
                        <span class="text-muted">Phương thức thanh toán:</span>
                        <span class="badge bg-success-subtle text-success">COD - Thanh toán khi nhận hàng</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="col-lg-6">
            <OrderSummaryComponent order="order" HidePlaceOrder="true"></OrderSummaryComponent>
        </div>
    </div>

    <!-- Items Table Card -->
    <div class="card rounded-4 border-light shadow-sm p-4 bg-white mb-5">
        <h5 class="fw-bold mb-3">
            <i class="bi bi-bag-check-fill text-primary me-2"></i>Danh Sách Sản Phẩm Đã Mua
        </h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 80px;">Hình ảnh</th>
                        <th scope="col">Tên sản phẩm</th>
                        <th scope="col" class="text-center">Số lượng</th>
                        <th scope="col" class="text-end">Đơn giá</th>
                        <th scope="col" class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.LineItems)
                    {
                        <tr>
                            <td>
                                <img src="@item.Product.ImageLink" alt="@item.Product.Name" style="width: 50px; height: 50px; object-fit: contain;" class="rounded bg-light p-1 border" />
                            </td>
                            <td>
                                <div class="fw-bold">@item.Product.Name</div>
                                <span class="badge bg-light text-muted border text-uppercase small">@item.Product.Brand</span>
                            </td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                            <td class="text-end">@item.Product.Price.ToString("c")</td>
                            <td class="text-end fw-bold text-danger">@((item.Price * item.Quantity).ToString("c"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private Order? order;

    [Parameter]
    public string? UniqueId { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!string.IsNullOrWhiteSpace(UniqueId))
        {
            order = viewOrderConfirmationUseCase.Execute(UniqueId);
        }
    }
}
