@page "/product/{id:int}"

@inject NavigationManager navigationManager
@inject IViewProductUseCase viewProductUseCase
@inject IAddProductToCartUseCase addProductToCartUseCase

@if (product != null)
{
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item"><a href="/products">Mỹ Phẩm</a></li>
            <li class="breadcrumb-item active text-capitalize text-truncate" style="max-width: 300px;" aria-current="page">@product.Name</li>
        </ol>
    </nav>

    <div class="product-detail-card">
        <div class="row g-5">
            <!-- Left: Product Image Box -->
            <div class="col-lg-5">
                <div class="product-gallery-box position-relative">
                    <span class="badge-brand">
                        <i class="bi bi-patch-check-fill text-primary"></i> Chính Hãng 100%
                    </span>
                    <span class="badge-promo">
                        <i class="bi bi-tag-fill"></i> Giảm 25%
                    </span>
                    <img class="product-gallery-img" src="@product.ImageLink" alt="@product.Name" />
                </div>

                <div class="d-flex justify-content-around mt-3 p-3 bg-light rounded-3 text-center small text-muted">
                    <div><i class="bi bi-box-seam text-primary fs-5 d-block"></i> Đóng gói cẩn thận</div>
                    <div><i class="bi bi-shield-lock text-success fs-5 d-block"></i> Đảm bảo chất lượng</div>
                    <div><i class="bi bi-arrow-counterclockwise text-warning fs-5 d-block"></i> Đổi trả 7 ngày</div>
                </div>
            </div>

            <!-- Right: Product Info -->
            <div class="col-lg-7 d-flex flex-column">
                <div class="product-detail-brand">
                    <i class="bi bi-award-fill"></i> @product.Brand Official Store
                </div>
                <h1 class="product-detail-title">@product.Name</h1>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-warning small">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <span class="fw-bold small">4.9 / 5</span>
                    <span class="text-muted small">|</span>
                    <span class="text-muted small">186 Đánh Giá</span>
                    <span class="text-muted small">|</span>
                    <span class="text-success small fw-bold"><i class="bi bi-check-circle-fill"></i> Còn hàng</span>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 d-flex align-items-baseline gap-3">
                    <span class="product-detail-price mb-0">@product.Price.ToString("c")</span>
                    <span class="text-decoration-line-through text-muted fs-5">@((product.Price * 1.25).ToString("c"))</span>
                    <span class="badge bg-danger rounded-pill">-25% TIẾT KIỆM</span>
                </div>

                <div class="product-guarantee-box">
                    <h6 class="fw-bold mb-2"><i class="bi bi-info-circle text-primary me-2"></i>Mô Tả Sản Phẩm</h6>
                    <p class="text-secondary small mb-0 lh-lg">
                        @((MarkupString)product.Description)
                    </p>
                </div>

                <!-- Call To Actions -->
                <div class="d-flex flex-wrap gap-3 mt-auto pt-3">
                    <button class="btn-add-to-cart-lg flex-grow-1 justify-content-center" @onclick="AddToCart">
                        <i class="bi bi-cart-plus-fill fs-5"></i>
                        <span>Thêm Vào Giỏ Hàng</span>
                    </button>
                    <button class="btn btn-outline-danger btn-lg rounded-3 fw-bold px-4" @onclick="BuyNow">
                        <i class="bi bi-lightning-fill"></i> Mua Ngay
                    </button>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <a href="/products" class="text-muted small text-decoration-none">
                        <i class="bi bi-arrow-left"></i> Quay lại danh sách sản phẩm
                    </a>
                    <span class="text-muted small">Mã SP: #@product.ProductId</span>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-2">Đang tải chi tiết sản phẩm...</p>
    </div>
}

@code {
    private Product? product;

    [Parameter]
    public int Id { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (Id > 0)
        {
            product = viewProductUseCase.Execute(Id);
        }
    }

    private async Task AddToCart()
    {
        await addProductToCartUseCase.Execute(Id);
        navigationManager.NavigateTo("/cart");
    }

    private async Task BuyNow()
    {
        await addProductToCartUseCase.Execute(Id);
        navigationManager.NavigateTo("/placeorder");
    }
}
